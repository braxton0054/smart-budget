# Smart Budget — environment template.
# Copy to .env and fill in real values. .env is gitignored; this template is not.

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Host port published by the production Compose stack.
APP_PORT=3000

# Database and queue
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://smartbudget:CHANGE_ME@localhost:5433/smartbudget?schema=public
REDIS_URL=redis://localhost:6379

# Security — generate each with: openssl rand -base64 32
SESSION_SECRET=
# 32-byte key, base64 encoded, for AES-GCM encryption of per-shop payment credentials
CREDENTIALS_ENCRYPTION_KEY=

# AI providers — verify all credentials with: npm run env:check
# Z.AI uses an OpenAI-compatible API. Keep the key server-side only.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.7-flash
ZAI_MODEL_FALLBACKS=glm-4.5-flash

# OpenCode Go / Console inference also exposes an OpenAI-compatible API.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
OPENCODE_MODEL=hy4-flash-free
# Comma-separated active fallback chain; use IDs listed by /models.
OPENCODE_MODEL_FALLBACKS=mimo-v2.6-flash-free,iceman-free
# Backward-compatible alias used by the admin settings presence check.
OPENAI_API_KEY=

# Google OAuth — sign in / sign up
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend — platform email
RESEND_API_KEY=
EMAIL_FROM="Smart Budget <no-reply@yourdomain.com>"

# Superadmin — Google sign-in only, no password. Comma-separate multiple emails.
SUPERADMIN_EMAIL=
SUPERADMIN_USERNAME=

# WhatsApp session worker (separate container)
# Bootstrap admin key only, generated once with: openssl rand -base64 48
# Per-shop sessions get their own session-scoped OpenWA API keys and webhook
# secrets, sealed with CREDENTIALS_ENCRYPTION_KEY in WaSession — never in .env.
OPENWA_URL=http://localhost:2785
# Local Compose: gateway reaches the host app at host.docker.internal.
OPENWA_CALLBACK_URL=http://host.docker.internal:3000
# Production overlay: gateway reaches the web service over the internal network.
OPENWA_PRODUCTION_CALLBACK_URL=http://web:3000
OPENWA_ADMIN_API_KEY=REPLACE_WITH_RANDOM_32_CHAR_KEY
OPENWA_PORT=2785
OPENWA_ENGINE=baileys
# Hosts allowed through OpenWA's webhook SSRF guard.
OPENWA_WEBHOOK_HOST=host.docker.internal
OPENWA_SSRF_ALLOWED_HOSTS=web
# Set before FIRST OpenWA boot only. Changing it after keys exist locks them out.
# Leave empty for an existing installation that already generated keys.
OPENWA_API_KEY_PEPPER=
# Optional: only needed by an older shared webhook. New sessions use a signed
# per-shop URL with a secret stored in the database.
OPENWA_WEBHOOK_SECRET=
