{
  "name": "smartbudget-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "docker compose up -d postgres redis wa-state-sync openwa",
    "openwa:pull": "docker pull ghcr.io/rmyndharis/openwa:0.32.1 && docker compose up -d openwa",
    "wa:sync": "docker compose up -d wa-state-sync",
    "prod:build": "docker compose -f docker-compose.yml -f docker-compose.prod.yml build",
    "prod:up": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "prod:down": "docker compose -f docker-compose.yml -f docker-compose.prod.yml down",
    "prod:ps": "docker compose -f docker-compose.yml -f docker-compose.prod.yml ps",
    "prod:logs": "docker compose -f docker-compose.yml -f docker-compose.prod.yml logs -f",
    "env:check": "NODE_OPTIONS=--dns-result-order=ipv4first node scripts/check-env.mjs",
    "dev": "NODE_OPTIONS=--dns-result-order=ipv4first next dev",
    "build": "NODE_OPTIONS=--dns-result-order=ipv4first next build",
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first next start",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "node prisma/seed.mjs",
    "openwa:key": "docker compose exec -T openwa cat /app/data/.api-key",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.10",
    "ioredis": "^6.1.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
