# Copy to .env on the VPS and fill in. Never commit .env.
#   cp deploy.example.env .env

# Postgres (compose refuses to start while POSTGRES_PASSWORD is unset/empty).
POSTGRES_DB=smartbudget
POSTGRES_USER=smartbudget
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Host-side Caddy reverse_proxies to this port; see deploy/smartbudget.caddy.
APP_PORT=3012

# Inlined into the client bundle at docker build time.
NEXT_PUBLIC_SITE_URL=https://smartbudget.mtandaolabs.com

# Used from phase 1 onward. Leave empty until the code reads them:
# AES-GCM key for encrypted payment credentials. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
LLM_API_KEY=
PAYHERO_USERNAME=
PAYHERO_API_KEY=
